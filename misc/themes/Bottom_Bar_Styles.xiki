module Xiki

  Styles.mode_line :bg=>'unspecified', :fg=>"#ddd", :bold=>true
  Styles.mode_line_inactive :bg=>'unspecified', :fg=>"#777", :bold=>false
  Styles.mode_line_underline :fg=>"#5cf", :bold=>true, :underline=>true
  Styles.mode_line_inactive_underline :fg=>"#777", :bold=>false, :underline=>true

  Styles.mode_line_transparent :bg=>"unspecified", :fg=>"#ccc", :underline=>nil
  Styles.mode_line_transparent_activatable :bg=>"unspecified", :fg=>"#fff", :underline=>nil
  Styles.mode_line_transparent_underline :bg=>"unspecified", :fg=>"#fff", :underline=>1, :bold=>true
  Styles.mode_line_transparent_underline_activatable :bg=>"unspecified", :fg=>"#5cf", :underline=>1, :bold=>true

  Styles.mode_line_sides :bg=>"unspecified", :fg=>"#777", :underline=>nil
  Styles.mode_line_sides_underline :bg=>"unspecified", :fg=>"#777", :underline=>1, :bold=>true

  Styles.mode_line_file :fg=>"#fff", :bold=>true
  Styles.mode_line_file_underline :fg=>"#5cf", :underline=>true, :bold=>true

  Styles.vertical_border :fg=>"#555", :bg=>'unspecified', :underline=>nil

  Styles.filter_highlight :fg=>"#ffbb00", :bold=>true

  Styles.region :bg=>"#333"

  # Message area at bottom
  Styles.minibuffer_prompt :size=>110, :face=>"Monaco", :fg=>"#fff"
  Styles.minibuffer :size=>110, :face=>"Monaco", :fg=>"#eee"
  Styles.echo_area :size=>110, :face=>"Monaco", :fg=>"#eee"

end
